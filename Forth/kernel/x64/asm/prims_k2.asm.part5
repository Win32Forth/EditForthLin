_prune_wid:
    ; cbz     x0, _prune_ret
    mov rax, QWORD PTR arm_x0
    cmp rax, 0
    je _prune_ret
    ; mov     x3, x0
    mov rax, QWORD PTR arm_x0
    mov QWORD PTR arm_x3, rax
    ; mov     x4, x1
    mov rax, QWORD PTR arm_x1
    mov QWORD PTR arm_x4, rax
    ; mov     x5, #0
    mov rax, 0
    mov QWORD PTR arm_x5, rax
_prune_thread:
    ; cmp     x5, #16
    mov rax, QWORD PTR arm_x5
    cmp rax, 10h
    seto BYTE PTR arm_v
    sets BYTE PTR arm_n
    setz BYTE PTR arm_z
    setnc BYTE PTR arm_c
    ; b.hs    _prune_ret
    cmp BYTE PTR arm_c, 0
    jne _prune_ret
    ; add     x0, x3, x5, lsl #3
    mov rax, QWORD PTR arm_x3
    mov rcx, QWORD PTR arm_x5
    shl rcx, 3
    add rax, rcx
    mov QWORD PTR arm_x0, rax
_prune_head:
    ; ldr     x2, [x0]
    mov r10, QWORD PTR arm_x0
    mov rax, QWORD PTR [r10]
    mov QWORD PTR arm_x2, rax
    ; cbz     x2, _prune_next
    mov rax, QWORD PTR arm_x2
    cmp rax, 0
    je _prune_next
    ; cmp     x2, x4
    mov rax, QWORD PTR arm_x2
    mov rcx, QWORD PTR arm_x4
    cmp rax, rcx
    seto BYTE PTR arm_v
    sets BYTE PTR arm_n
    setz BYTE PTR arm_z
    setnc BYTE PTR arm_c
    ; b.lo    _prune_next
    cmp BYTE PTR arm_c, 0
    je _prune_next
    ; ldr     x2, [x2, #-16]
    mov r10, QWORD PTR arm_x2
    add r10, -16
    mov rax, QWORD PTR [r10]
    mov QWORD PTR arm_x2, rax
    ; str     x2, [x0]
    mov r10, QWORD PTR arm_x0
    mov rax, QWORD PTR arm_x2
    mov QWORD PTR [r10], rax
    ; b       _prune_head
    jmp _prune_head
_prune_next:
    ; add     x5, x5, #1
    mov rax, QWORD PTR arm_x5
    add rax, 1
    mov QWORD PTR arm_x5, rax
    ; b       _prune_thread
    jmp _prune_thread
_prune_ret:
    ; ret
    jmp QWORD PTR arm_x30
