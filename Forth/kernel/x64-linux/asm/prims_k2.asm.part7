    lea r10, [rsp]
    add r10, 0x30
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; str     x0, [sp, #56]
    lea r10, [rsp]
    add r10, 0x38
    mov rax, qword [rel arm_x0]
    mov qword [r10], rax
    ; bl      host_native_ret7
    push rbx
    mov rbx, rsp
    and rsp, -16
    sub rsp, 32
    mov rdi, qword [rel arm_x0]
    mov rsi, qword [rel arm_x1]
    mov rdx, qword [rel arm_x2]
    mov rcx, qword [rel arm_x3]
    mov r8, qword [rel arm_x4]
    mov r9, qword [rel arm_x5]
    mov rax, qword [rel arm_x6]
    mov qword [rsp], rax
    mov rax, qword [rel arm_x7]
    mov qword [rsp+8], rax
    mov rax, qword [rbx+8]
    mov qword [rsp+16], rax
    call host_native_ret7
    mov qword [rel arm_x0], rax
    mov rsp, rbx
    pop rbx
    ; ldr     x0, [sp, #56]
    lea r10, [rsp]
    add r10, 0x38
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; mov     x1, #0x1000
    mov rax, 0x1000
    mov qword [rel arm_x1], rax
    ; mov     x2, #5
    mov rax, 5
    mov qword [rel arm_x2], rax
    ; bl      host_mprotect
    push rbx
    mov rbx, rsp
    and rsp, -16
    sub rsp, 32
    mov rdi, qword [rel arm_x0]
    mov rsi, qword [rel arm_x1]
    mov rdx, qword [rel arm_x2]
    mov rcx, qword [rel arm_x3]
    mov r8, qword [rel arm_x4]
    mov r9, qword [rel arm_x5]
    mov rax, qword [rel arm_x6]
    mov qword [rsp], rax
    mov rax, qword [rel arm_x7]
    mov qword [rsp+8], rax
    mov rax, qword [rbx+8]
    mov qword [rsp+16], rax
    call host_mprotect
    mov qword [rel arm_x0], rax
    mov rsp, rbx
    pop rbx
    ; cbnz    x0, _ns_free
    mov rax, qword [rel arm_x0]
    cmp rax, 0
    jne _ns_free
    ; ldr     x0, [sp, #56]
    lea r10, [rsp]
    add r10, 0x38
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; mov     x1, #0x1000
    mov rax, 0x1000
    mov qword [rel arm_x1], rax
    ; bl      host_icache_inval
    push rbx
    mov rbx, rsp
    and rsp, -16
    sub rsp, 32
    mov rdi, qword [rel arm_x0]
    mov rsi, qword [rel arm_x1]
    mov rdx, qword [rel arm_x2]
    mov rcx, qword [rel arm_x3]
    mov r8, qword [rel arm_x4]
    mov r9, qword [rel arm_x5]
    mov rax, qword [rel arm_x6]
    mov qword [rsp], rax
    mov rax, qword [rel arm_x7]
    mov qword [rsp+8], rax
    mov rax, qword [rbx+8]
    mov qword [rsp+16], rax
    call host_icache_inval
    mov qword [rel arm_x0], rax
    mov rsp, rbx
    pop rbx
    ; mov     x0, #0
    mov rax, 0
    mov qword [rel arm_x0], rax
    ; lea x1, native_dsp_end
    lea rax, [rel native_dsp_end]
    mov qword [rel arm_x1], rax
    ; sub     x1, x1, #64
    mov rax, qword [rel arm_x1]
    sub rax, 0x40
    mov qword [rel arm_x1], rax
    ; ldr     x2, [sp, #56]
    lea r10, [rsp]
    add r10, 0x38
    mov rax, qword [r10]
    mov qword [rel arm_x2], rax
    ; bl      _call_native_regs
    lea rax, [rel xret_144]
    mov qword [rel arm_x30], rax
    jmp _call_native_regs
    xret_144:
    ; str     x0, [sp, #64]
    lea r10, [rsp]
    add r10, 0x40
    mov rax, qword [rel arm_x0]
    mov qword [r10], rax
    ; ldr     x0, [sp, #56]
    lea r10, [rsp]
    add r10, 0x38
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; mov     x1, #0x1000
    mov rax, 0x1000
    mov qword [rel arm_x1], rax
    ; bl      host_free_exec
    push rbx
    mov rbx, rsp
    and rsp, -16
    sub rsp, 32
    mov rdi, qword [rel arm_x0]
    mov rsi, qword [rel arm_x1]
    mov rdx, qword [rel arm_x2]
    mov rcx, qword [rel arm_x3]
    mov r8, qword [rel arm_x4]
    mov r9, qword [rel arm_x5]
    mov rax, qword [rel arm_x6]
    mov qword [rsp], rax
    mov rax, qword [rel arm_x7]
    mov qword [rsp+8], rax
    mov rax, qword [rbx+8]
    mov qword [rsp+16], rax
    call host_free_exec
    mov qword [rel arm_x0], rax
    mov rsp, rbx
    pop rbx
    ; cbnz    x0, _ns_bad
    mov rax, qword [rel arm_x0]
    cmp rax, 0
    jne _ns_bad
    ; ldr     x0, [sp, #64]
    lea r10, [rsp]
    add r10, 0x40
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; cmp     x0, #7
    mov rax, qword [rel arm_x0]
    cmp rax, 7
    seto byte [rel arm_v]
    sets byte [rel arm_n]
    setz byte [rel arm_z]
    setnc byte [rel arm_c]
    ; b.ne    _ns_bad
    cmp byte [rel arm_z], 0
    je _ns_bad
    ; mov     x0, #0
    mov rax, 0
    mov qword [rel arm_x0], rax
    ; b       _ns_out
    jmp _ns_out
_ns_free:
    ; ldr     x0, [sp, #56]
    lea r10, [rsp]
    add r10, 0x38
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; mov     x1, #0x1000
    mov rax, 0x1000
    mov qword [rel arm_x1], rax
    ; bl      host_free_exec
    push rbx
    mov rbx, rsp
    and rsp, -16
    sub rsp, 32
    mov rdi, qword [rel arm_x0]
    mov rsi, qword [rel arm_x1]
    mov rdx, qword [rel arm_x2]
    mov rcx, qword [rel arm_x3]
    mov r8, qword [rel arm_x4]
    mov r9, qword [rel arm_x5]
    mov rax, qword [rel arm_x6]
    mov qword [rsp], rax
    mov rax, qword [rel arm_x7]
    mov qword [rsp+8], rax
    mov rax, qword [rbx+8]
    mov qword [rsp+16], rax
    call host_free_exec
    mov qword [rel arm_x0], rax
    mov rsp, rbx
    pop rbx
_ns_bad:
    ; mov     x0, #-1
    mov rax, -1
    mov qword [rel arm_x0], rax
_ns_out:
    ; ldp     x29, x30, [sp, #32]
    lea r10, [rsp]
    add r10, 0x20
    mov rax, qword [r10]
    mov rcx, qword [r10+8]
    mov qword [rel arm_x29], rax
    mov qword [rel arm_x30], rcx
    ; add     sp, sp, #96
    mov rax, rsp
    add rax, 0x60
    mov rsp, rax
    ; str     x20, [x22, #-8]!
    mov rax, qword [rel arm_x22]
    add rax, -8
    mov qword [rel arm_x22], rax
    mov r10, qword [rel arm_x22]
    mov rax, qword [rel arm_x20]
    mov qword [r10], rax
    ; mov     x20, x0
    mov rax, qword [rel arm_x0]
    mov qword [rel arm_x20], rax
    ; cbnz    x28, next_debug_gate
    mov rax, qword [rel arm_x28]
    cmp rax, 0
    jne next_debug_gate
    ; lea x1, debug_break_asap
    lea rax, [rel debug_break_asap]
    mov qword [rel arm_x1], rax
    ; ldr     x1, [x1]
    mov r10, qword [rel arm_x1]
    mov rax, qword [r10]
    mov qword [rel arm_x1], rax
    ; cbnz    x1, next_debug_gate
    mov rax, qword [rel arm_x1]
    cmp rax, 0
    jne next_debug_gate
    ; ldr     x21, [x19], #8
    mov r10, qword [rel arm_x19]
    mov rax, qword [r10]
    mov qword [rel arm_x21], rax
    mov rax, qword [rel arm_x19]
    add rax, 8
    mov qword [rel arm_x19], rax
    ; ldr     x1, [x21]
    mov r10, qword [rel arm_x21]
    mov rax, qword [r10]
    mov qword [rel arm_x1], rax
    ; br      x1
    mov rax, qword [rel arm_x1]
    jmp rax
next_debug_gate:
    ; lea x16, next_debug
    lea rax, [rel next_debug]
    mov qword [rel arm_x16], rax
    ; br      x16
    mov rax, qword [rel arm_x16]
    jmp rax
