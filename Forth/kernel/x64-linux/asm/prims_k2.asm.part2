    dq XSPACES, XSPACES_END
section .bootptr align=8
    ; ALIGN 8
align 8
    ; DCQ     row_XSPACES
    dq row_XSPACES
section .text
XSPACES:
    ; mov     x1, x20
    mov rax, qword [r15+160]
    mov qword [r15+8], rax
    ; ldr     x20, [x22], #8
    mov r10, qword [r15+176]
    mov rax, qword [r10]
    mov qword [r15+160], rax
    mov rax, qword [r15+176]
    add rax, 8
    mov qword [r15+176], rax
    ; cmp     x1, #0
    mov rax, qword [r15+8]
    cmp rax, 0
    seto byte [r15+251]
    sets byte [r15+248]
    setz byte [r15+249]
    setnc byte [r15+250]
    ; b.le    XSPACES_END
    cmp byte [r15+249], 0
    jne XSPACES_END
    mov r11b, byte [r15+248]
    cmp r11b, byte [r15+251]
    jne XSPACES_END
    ; sub     sp, sp, #64
    mov rax, rsp
    sub rax, 0x40
    mov rsp, rax
    ; stp     x29, x30, [sp, #32]
    lea r10, [rsp]
    add r10, 0x20
    mov rax, qword [r15+232]
    mov qword [r10+0], rax
    mov rax, qword [r15+240]
    mov qword [r10+8], rax
_spaces_loop:
    ; str     x1, [sp, #48]
    lea r10, [rsp]
    add r10, 0x30
    mov rax, qword [r15+8]
    mov qword [r10], rax
    ; mov     x0, #32
    mov rax, 0x20
    mov qword [r15+0], rax
    ; bl      _putchar
    lea rax, [rel xret_49]
    mov qword [r15+240], rax
    jmp _putchar
    xret_49:
    ; ldr     x1, [sp, #48]
    lea r10, [rsp]
    add r10, 0x30
    mov rax, qword [r10]
    mov qword [r15+8], rax
    ; subs    x1, x1, #1
    mov rax, qword [r15+8]
    sub rax, 1
    seto byte [r15+251]
    sets byte [r15+248]
    setz byte [r15+249]
    setnc byte [r15+250]
    mov qword [r15+8], rax
    ; b.ne    _spaces_loop
    cmp byte [r15+249], 0
    je _spaces_loop
    ; ldp     x29, x30, [sp, #32]
    lea r10, [rsp]
    add r10, 0x20
    mov rax, qword [r10]
    mov rcx, qword [r10+8]
    mov qword [r15+232], rax
    mov qword [r15+240], rcx
    ; add     sp, sp, #64
    mov rax, rsp
    add rax, 0x40
    mov rsp, rax
XSPACES_END:
    ; cbnz    x28, next_debug_gate
    mov rax, qword [r15+224]
    cmp rax, 0
    jne next_debug_gate
    ; lea x1, debug_break_asap
    lea rax, [rel debug_break_asap]
    mov qword [r15+8], rax
    ; ldr     x1, [x1]
    mov r10, qword [r15+8]
    mov rax, qword [r10]
    mov qword [r15+8], rax
    ; cbnz    x1, next_debug_gate
    mov rax, qword [r15+8]
    cmp rax, 0
    jne next_debug_gate
    ; ldr     x21, [x19], #8
    mov r10, qword [r15+152]
    mov rax, qword [r10]
    mov qword [r15+168], rax
    mov rax, qword [r15+152]
    add rax, 8
    mov qword [r15+152], rax
    ; ldr     x1, [x21]
    mov r10, qword [r15+168]
    mov rax, qword [r10]
    mov qword [r15+8], rax
    ; br      x1
    mov rax, qword [r15+8]
    jmp rax
