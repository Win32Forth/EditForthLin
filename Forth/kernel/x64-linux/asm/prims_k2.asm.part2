hl_XREFILL:
    ; DCB "REFILL ( -- flag ) next line when a file is the source", 0
    db "REFILL ( -- flag ) next line when a file is the source", 0
section .bootword align=8
    ; ALIGN 8
align 8
row_XREFILL:
    ; DCQ     nm_XREFILL, hl_XREFILL
    dq nm_XREFILL, hl_XREFILL
    ; DCQ     0
    dq 0
    ; DCQ     XREFILL, 0
    dq XREFILL, 0
section .bootptr align=8
    ; ALIGN 8
align 8
    ; DCQ     row_XREFILL
    dq row_XREFILL
section .text
XREFILL:
    ; sub     sp, sp, #64
    mov rax, rsp
    sub rax, 0x40
    mov rsp, rax
    ; stp     x29, x30, [sp, #32]
    lea r10, [rsp]
    add r10, 0x20
    mov rax, qword [rel arm_x29]
    mov qword [r10+0], rax
    mov rax, qword [rel arm_x30]
    mov qword [r10+8], rax
    ; lea x0, blk_var
    lea rax, [rel blk_var]
    mov qword [rel arm_x0], rax
    ; ldr     x0, [x0]
    mov r10, qword [rel arm_x0]
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; cbnz    x0, _refill_block
    mov rax, qword [rel arm_x0]
    cmp rax, 0
    jne _refill_block
    ; lea x0, line_mode
    lea rax, [rel line_mode]
    mov qword [rel arm_x0], rax
    ; ldr     x0, [x0]
    mov r10, qword [rel arm_x0]
    mov rax, qword [r10]
    mov qword [rel arm_x0], rax
    ; cbz     x0, _refill_no
    mov rax, qword [rel arm_x0]
    cmp rax, 0
    je _refill_no
    ; bl      _take_line
    lea rax, [rel xret_54]
    mov qword [rel arm_x30], rax
    jmp _take_line
    xret_54:
    ; ldp     x29, x30, [sp, #32]
    lea r10, [rsp]
    add r10, 0x20
    mov rax, qword [r10]
    mov rcx, qword [r10+8]
    mov qword [rel arm_x29], rax
    mov qword [rel arm_x30], rcx
    ; add     sp, sp, #64
    mov rax, rsp
