section .rodata
str_act_interp:
    ; DCB "ACTIVATE is only valid inside a colon definition", 10, 0
    db "ACTIVATE is only valid inside a colon definition", 0xa, 0
str_act_self:
    ; DCB "ACTIVATE: a task cannot activate itself", 10, 0
    db "ACTIVATE: a task cannot activate itself", 0xa, 0
str_allot_over:
    ; DCB "ALLOT: dictionary full (need more USER-DICT space)", 10, 0
    db "ALLOT: dictionary full (need more USER-DICT space)", 0xa, 0
str_allot_under:
    ; DCB "ALLOT: below dictionary start", 10, 0
    db "ALLOT: below dictionary start", 0xa, 0
str_cores_console:
    ; DCB "? CORES only from the console task", 10, 0
    db "? CORES only from the console task", 0xa, 0
str_cores_word:
    ; DCB "? CORES: console only", 10, 0
    db "? CORES: console only", 0xa, 0
str_dict_full:
    ; DCB "dictionary full (code/data space exhausted)", 10, 0
    db "dictionary full (code/data space exhausted)", 0xa, 0
str_mbox_get_stuck:
    ; DCB "? MBOX>: no other task can send", 10, 0
    db "? MBOX>: no other task can send", 0xa, 0
str_mbox_put_stuck:
    ; DCB "? >MBOX: no other task can receive", 10, 0
    db "? >MBOX: no other task can receive", 0xa, 0
str_qget_stuck:
    ; DCB "? Q>: no other task can send", 10, 0
    db "? Q>: no other task can send", 0xa, 0
str_qput_stuck:
    ; DCB "? >Q: no other task can receive", 10, 0
    db "? >Q: no other task can receive", 0xa, 0
str_queue_n:
    ; DCB "? QUEUE: need at least 2 slots", 10, 0
    db "? QUEUE: need at least 2 slots", 0xa, 0
str_sleep_only:
    ; DCB "SLEEP: the console is the only awake task", 10, 0
    db "SLEEP: the console is the only awake task", 0xa, 0
str_slice_bad:
    ; DCB "? SLICE: sleeping task and a positive size", 10, 0
    db "? SLICE: sleeping task and a positive size", 0xa, 0
str_slice_console:
    ; DCB "? SLICE only from the console task", 10, 0
    db "? SLICE only from the console task", 0xa, 0
str_slice_none:
    ; DCB "? SLICE: task has no dictionary", 10, 0
    db "? SLICE: task has no dictionary", 0xa, 0
str_stop_console:
    ; DCB "STOP: the console task stays awake", 10, 0
    db "STOP: the console task stays awake", 0xa, 0
str_wait_stuck:
    ; DCB "? WAIT: no other task can SIGNAL", 10, 0
    db "? WAIT: no other task can SIGNAL", 0xa, 0
section .bwstr align=1
nm_XSOURCE_STORE:
    ; DCB "(SOURCE!)", 0
    db "(SOURCE!)", 0
hl_XSOURCE_STORE:
    ; DCB "(SOURCE!) ( c-addr u -- ) set this task's SOURCE and zero >IN", 0
    db "(SOURCE!) ( c-addr u -- ) set this task's SOURCE and zero >IN", 0
section .bootword align=8
    ; ALIGN 8
align 8
row_XSOURCE_STORE:
    ; DCQ     nm_XSOURCE_STORE, hl_XSOURCE_STORE
    dq nm_XSOURCE_STORE, hl_XSOURCE_STORE
    ; DCQ     0
    dq 0
    ; DCQ     XSOURCE_STORE, XSOURCE_STORE_END
    dq XSOURCE_STORE, XSOURCE_STORE_END
section .bootptr align=8
    ; ALIGN 8
align 8
    ; DCQ     row_XSOURCE_STORE
    dq row_XSOURCE_STORE
section .text
XSOURCE_STORE:
    ; stp     x29, x30, [sp, #-16]!
    add rsp, -16
    lea r10, [rsp]
    mov rax, qword [r15+232]
    mov qword [r10+0], rax
    mov rax, qword [r15+240]
    mov qword [r10+8], rax
    ; mov     x1, x20
    mov rax, qword [r15+160]
    mov qword [r15+8], rax
    ; ldr     x0, [x22], #8
    mov r10, qword [r15+176]
    mov rax, qword [r10]
    mov qword [r15+0], rax
    mov rax, qword [r15+176]
    add rax, 8
    mov qword [r15+176], rax
    ; ldr     x20, [x22], #8
    mov r10, qword [r15+176]
    mov rax, qword [r10]
    mov qword [r15+160], rax
    mov rax, qword [r15+176]
    add rax, 8
    mov qword [r15+176], rax
    ; bl      _set_source
    lea rax, [rel xret_105]
    mov qword [r15+240], rax
    jmp _set_source
    xret_105:
    ; ldp     x29, x30, [sp], #16
    lea r10, [rsp]
    mov rax, qword [r10]
    mov rcx, qword [r10+8]
    mov qword [r15+232], rax
    mov qword [r15+240], rcx
    add rsp, 0x10
XSOURCE_STORE_END:
    ; cbnz    x28, next_debug_gate
    mov rax, qword [r15+224]
    cmp rax, 0
    jne next_debug_gate
    ; lea x1, debug_break_asap
    lea rax, [rel debug_break_asap]
    mov qword [r15+8], rax
    ; ldr     x1, [x1]
    mov r10, qword [r15+8]
    mov rax, qword [r10]
    mov qword [r15+8], rax
    ; cbnz    x1, next_debug_gate
    mov rax, qword [r15+8]
    cmp rax, 0
    jne next_debug_gate
    ; ldr     x21, [x19], #8
    mov r10, qword [r15+152]
    mov rax, qword [r10]
    mov qword [r15+168], rax
    mov rax, qword [r15+152]
    add rax, 8
    mov qword [r15+152], rax
    ; ldr     x1, [x21]
    mov r10, qword [r15+168]
    mov rax, qword [r10]
    mov qword [r15+8], rax
    ; br      x1
    mov rax, qword [r15+8]
    jmp rax
