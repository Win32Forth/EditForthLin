    cmp rax, 0
    je _ev_fail
    ; ldp     x0, x1, [sp, #48]
    lea r10, [rsp]
    add r10, 0x30
    mov rax, qword [r10]
    mov rcx, qword [r10+8]
    mov qword [rel arm_x0], rax
    mov qword [rel arm_x1], rcx
    ; lea x2, source_base
    lea rax, [rel source_base]
    mov qword [rel arm_x2], rax
    ; str     x0, [x2]
    mov r10, qword [rel arm_x2]
    mov rax, qword [rel arm_x0]
    mov qword [r10], rax
    ; lea x2, source_cur
    lea rax, [rel source_cur]
    mov qword [rel arm_x2], rax
